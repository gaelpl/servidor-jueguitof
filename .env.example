# Puerto (Render/Railway lo inyectan automáticamente vía PORT).
PORT=3000

# Secreto para firmar los JWT. Cámbialo en producción por uno largo y aleatorio.
JWT_SECRET=cambia_esto_en_produccion

# Origen permitido para CORS y sockets.
# En producción: https://tu-app.vercel.app
CORS_ORIGIN=*

# Ruta del archivo SQLite. En entornos efímeros apunta a un disco persistente,
# p. ej. DB_PATH=/var/data/usuarios.db
DB_PATH=./BD/usuarios.db
